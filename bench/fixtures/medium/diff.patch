+class CategoryDiscount:
+    """A percent discount that varies by item category.
+
+    Unlike DiscountRule subclasses, this is applied per line item rather
+    than to the order subtotal as a whole, since the rate depends on
+    each line's category.
+    """
+
+    def __init__(self, category_rates: dict, default_rate: float = 0.0):
+        for category, rate in category_rates.items():
+            if not (0 <= rate <= 100):
+                raise ValueError(f"rate for {category!r} must be between 0 and 100")
+        if not (0 <= default_rate <= 100):
+            raise ValueError("default_rate must be between 0 and 100")
+        self.category_rates = dict(category_rates)
+        self.default_rate = default_rate
+
+    def rate_for(self, category: str) -> float:
+        return self.category_rates.get(category, self.default_rate)
+
+    def apply_to_amount(self, category: str, amount: float) -> float:
+        rate = self.rate_for(category)
+        return round(amount * (1 - rate / 100), 2)
+
+    def categories(self):
+        return sorted(self.category_rates.keys())
+
+    def describe(self) -> str:
+        parts = [f"{cat}={rate}%" for cat, rate in sorted(self.category_rates.items())]
+        parts.append(f"default={self.default_rate}%")
+        return ", ".join(parts)
+
+
