+def round_amount(value: float, mode: str = ROUND_NEAREST) -> float:
+    """Round a currency amount to cents using the given rounding mode."""
+    if mode not in ROUNDING_MODES:
+        raise ValueError(f"unknown rounding mode: {mode}")
+    cents = value * 100
+    if mode == ROUND_UP:
+        cents = math.ceil(cents)
+    elif mode == ROUND_DOWN:
+        cents = math.floor(cents)
+    else:
+        cents = round(cents)
+    return cents / 100
 
