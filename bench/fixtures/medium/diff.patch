+def import_category_rates(path: str) -> dict:
+    """Read a two-column (category, percent) CSV into a rates dict.
+
+    This is the on-disk format for the per-category discount tables that
+    feed inv.discounts.CategoryDiscount.
+    """
+    rates = {}
+    with open(path, newline="") as f:
+        reader = csv.DictReader(f)
+        for row in reader:
+            rates[row["category"]] = float(row["percent"])
+    return rates
+
+
+def export_category_rates(rates: dict, path: str) -> None:
+    with open(path, "w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=CATEGORY_RATE_FIELDS)
+        writer.writeheader()
+        for category in sorted(rates.keys()):
+            writer.writerow({"category": category, "percent": rates[category]})
+
