+def average_price(prices: List[float]) -> float:
+    """Return the arithmetic mean of a list of prices, rounded to cents."""
+    if not prices:
+        raise ValueError("prices must not be empty")
+    return round(sum(prices) / len(prices), 2)
+
+
+def clamp_price(price: float, low: float, high: float) -> float:
+    """Clamp a price into the inclusive [low, high] range."""
+    if low > high:
+        raise ValueError("low must not be greater than high")
+    return max(low, min(price, high))
